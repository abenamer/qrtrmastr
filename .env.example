# Copy to .env and fill in the values. Never commit a real .env file.
# The .claude/settings.json of this project denies the assistant from reading .env.

# --- Database ---
# With the Compose service (docs/runbooks/develop.md), the host port is 5434 by default so it
# does not collide with a PostgreSQL that already listens on 5432.
POSTGRES_USER=qm
POSTGRES_PASSWORD=
POSTGRES_DB=qrtrmastr
QM_DB_PORT=5434
DATABASE_URL=postgres://qm:<password>@127.0.0.1:5434/qrtrmastr
DB_MAX_CONNECTIONS=4

# --- The qm container (docker compose run --rm qm ...) ---
# Where your Takeout exports live on the host; mounted read-only at /data in the container.
QM_DATA_DIR=~/qm-data
# Where config.toml with your redaction terms lives; mounted read-only at /config.
QM_CONFIG_DIR=~/.config/qrtrmastr
# The container runs as this user so the files it writes are yours: the output of `id -u` and `id -g`.
QM_UID=1000
QM_GID=1000
# The zone "today" is judged in when `qm due` runs without --as-of.
TZ=America/New_York

# --- Logging ---
RUST_LOG=info,sqlx=warn
